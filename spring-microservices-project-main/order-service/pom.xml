<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.microservices</groupId>
        <artifactId>microservices-project</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>order-service</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Registers with Eureka so it can be discovered by other services -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <!--
            OpenFeign — declarative HTTP client.
            @FeignClient interface → Spring generates a RestTemplate-like proxy at runtime.
            Also pulls in spring-cloud-starter-loadbalancer transitively,
            which replaces the deprecated Netflix Ribbon for client-side LB.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Resilience4j — Circuit Breaker, Retry, Bulkhead, Rate Limiter.
            spring-cloud-starter-circuitbreaker-resilience4j pulls in:
              - resilience4j-spring-boot3  (annotation support: @CircuitBreaker, @Retry, @Bulkhead)
              - resilience4j-reactor       (reactive support, not used here)
            Version is managed by Spring Cloud BOM — no explicit version needed.
        -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!--
            AOP support — REQUIRED for @CircuitBreaker, @Retry, @Bulkhead annotations.
            Resilience4j uses Spring AOP to intercept method calls and apply resilience logic.
            Without this, the annotations are silently ignored (no error, no protection).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
    </dependencies>

</project>
